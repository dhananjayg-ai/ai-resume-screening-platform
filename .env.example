# Copy this file to .env and adjust as needed.
# All values are optional and have sane defaults for local/demo use.

# --- Backend: database & uploads ---
DATABASE_URL=sqlite:///./resume_screening.db
UPLOAD_DIR=./uploaded_resumes

# --- Backend: CORS ---
CORS_ORIGINS=*

# --- Backend: SMTP (email notifications) ---
# Leave these unset to run in "demo mode": notifications will be logged to the
# NotificationLog table instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# false (default) = STARTTLS on port 587; true = implicit SSL/TLS (e.g. port 465)
SMTP_USE_SSL=false

# --- Backend: matching weights (must sum sensibly, each 0-1) ---
TFIDF_WEIGHT=0.5
SKILL_WEIGHT=0.5

# --- Backend: duplicate detection ---
DUPLICATE_SHINGLE_SIZE=5
DUPLICATE_SIMILARITY_THRESHOLD=0.6

# --- Frontend ---
API_BASE_URL=http://localhost:8000
